{
  "name": "user-management-api-tests",
  "version": "1.0.0",
  "description": "Playwright Test + TypeScript API automation for the User Management API",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:contract": "playwright test --grep @contract",
    "test:exploratory": "playwright test --grep @exploratory",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
